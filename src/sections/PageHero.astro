---
interface Props {
  backgroundImage: string;
  backgroundAlt: string;
  contentClass?: string;
}

const {
  backgroundImage,
  backgroundAlt,
  contentClass = "pt-28 pb-16",
} = Astro.props;
---

<section class="page-hero relative min-h-screen w-full overflow-hidden">
  <img
    src={backgroundImage}
    alt={backgroundAlt}
    class="absolute inset-0 h-full w-full object-cover"
  />

  <div class="absolute inset-0 hero-overlay-main"></div>
  <div class="absolute inset-0 hero-overlay-side"></div>

  <slot name="decorations" />

  <div class="relative z-10 flex min-h-screen items-center">
    <div class="container">
      <div class:list={["max-w-3xl text-left", contentClass]}>
        <slot />
      </div>
    </div>
  </div>
</section>
