---
interface Props {
  desktopColumnsClass: string;
  id?: string;
  class?: string;
}

const { desktopColumnsClass, id, class: className } = Astro.props;
---

<section id={id} class:list={["relative overflow-hidden py-24 md:py-32", className]}>
  <div class="container max-w-6xl">
    <div class:list={["grid gap-14 lg:items-start", desktopColumnsClass]}>
      <div class="lg:sticky lg:top-32">
        <slot name="sticky" />
      </div>

      <div class="space-y-6">
        <slot name="content" />
      </div>
    </div>
  </div>
</section>
